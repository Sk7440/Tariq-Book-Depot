{
  "name": "tariq-book-depot",
  "private": true,
  "engines": {
    "node": ">=22.0.0 <25.0.0"
  },
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:storefront": "npm --workspace apps/storefront run dev",
