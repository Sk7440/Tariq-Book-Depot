{
  "name": "tariq-book-depot",
  "private": true,
  "engines": {
    "node": ">=22.0.0 <25.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:backend": "npm --workspace apps/backend run dev",
    "dev:storefront": "npm --workspace apps/storefront run dev",
    "build:backend": "npm --workspace apps/backend run build",
    "build:storefront": "npm --workspace apps/storefront run build",
    "typecheck": "npm --workspace apps/storefront run typecheck",
    "lint": "npm --workspace apps/storefront run lint",
    "test:e2e": "npm --workspace apps/storefront run test:e2e"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "gsap": "^3.15.1"
  }
}
